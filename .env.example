# ---- Echoes of Fate: AI narrator settings ----
# Copy this file to .env and fill in ONE provider.
# Any OpenAI-compatible Chat Completions API works.

# Options: gemini | groq | openai | ollama | offline
AI_PROVIDER=gemini

# API key for the provider (not needed for ollama / offline)
#   Gemini (free tier): https://aistudio.google.com/apikey
#   Groq   (free tier): https://console.groq.com/keys
AI_API_KEY=

# Optional overrides (defaults depend on the provider)
# AI_MODEL=gemini-3.5-flash
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_TIMEOUT=40
